@startuml
title DFD As-Is: Приём платежей и учёт финансов

actor "Пациент" as Patient
actor "Банк / Эквайер" as Bank
actor "Налоговая / ФНС" as Tax

rectangle "Приём оплаты\n(кассир, ККМ)" as P3
rectangle "Учёт платежей\n(1С:Бухгалтерия)" as P4

database "ККМ / фискальная память\n(логи чеков)" as D4
database "1С:Бухгалтерия\n(файловая база)" as D5
database "Журнал платежей\n(Excel на общем диске)" as D6

Patient --> P3 : Данные оплаты\nсумма, способ оплаты,\nиногда ФИО/телефон (PII+фин.)
P3 --> D4 : Чек, фискальные данные\n(сумма, дата, номер, иногда PII)
P3 --> P4 : Информация о платеже\n(компонента 1С OLE)

P4 --> D5 : Платёжные проводки,\nсчета, договоры (фин.+PII)
D5 --> P4

P3 --> D6 : Журнал платежей\nФИО пациента, услуга,\nсумма, дата (PII+фин.)

P4 --> Tax : Отчётность\nагрегированные фин. данные\n(иногда PII)

P3 --> Bank : Авторизация/проведение платежа\nчерез ККМ

@enduml