@startuml
title DFD As-Is: Учёт ТМЦ и внутренний документооборот

actor "Поставщик" as Supplier
actor "Налоговая / контролирующие органы" as Tax

rectangle "Учёт ТМЦ\n(1С:Торговля и склад)" as P5
rectangle "Бухгалтерский учёт\n(1С:Бухгалтерия)" as P6
rectangle "Обмен документами\n(Excel / почта)" as P7

database "1С:Торговля и склад\n(файловая база)" as D7
database "1С:Бухгалтерия\n(файловая база)" as D5
database "Общий файловый диск\n(договора, накладные,\nExcel-отчёты)" as D8
database "Почтовый сервер\n(Exchange)" as D9

Supplier --> P5 : Накладные, счета, договоры\n(финансовые + PII контрагентов)
P5 --> D7 : Учёт ТМЦ,\nдвижения по складу
D7 --> P5

P5 --> P6 : Информация о закупках\n(интеграция 1С–1С)
P6 --> D5 : Проводки, платежи,\nдоговоры (фин.+PII)
D5 --> P6

P5 --> D8 : Скан-копии накладных,\nдоговоров, Excel-отчёты
P6 --> D8 : Excel-выгрузки из 1С,\nотчёты по финансам

P5 --> D9 : Письма с вложениями\n(договора, накладные,\nExcel-реестры)
P6 --> D9 : Письма с отчётами,\nфин. документами

P6 --> Tax : Отчётность,\nфинансовые данные

@enduml